# === Event Configuration ===
EVENT_NAME=Super Bowl
EVENT_DATETIME=2026-02-08T18:30:00
EVENT_TIMEZONE=America/New_York
STOP_AT=2026-02-07T23:59:00
RUN_EVERY_MINUTES=60

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
EMAIL_FROM=you@gmail.com
EMAIL_TO=recipient@example.com

# === Dry-run mode (prints instead of emailing) ===
DRY_RUN=true

# === Database ===
DB_PATH=./data/tracker.db

# === Debug ===
# Set to 1 to save screenshots, HTML, network logs on failures
DEBUG_CAPTURE=0

# === Marketplace Event URLs (REQUIRED for reliable tracking) ===
# Set these to the specific event page URLs for each marketplace.
# Without these, connectors fall back to search which is unreliable.

# SeatGeek
SEATGEEK_EVENT_URL=https://seatgeek.com/super-bowl-tickets/2-8-2026-santa-clara-california-levi-s-stadium/nfl/17382581
SEATGEEK_EVENT_ID=
SEATGEEK_API_KEY=

# StubHub
# API mode: register at https://developer.stubhub.com for credentials.
STUBHUB_EVENT_URL=https://www.stubhub.com/super-bowl-santa-clara-tickets-2-8-2026/event/157245215/
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=
STUBHUB_EVENT_ID=

# Vivid Seats
VIVIDSEATS_EVENT_URL=

# TickPick
TICKPICK_EVENT_URL=

# On Location (NFL hospitality packages — tracked separately)
ONLOCATION_EVENT_URL=

# === Concurrency ===
MAX_CONCURRENT_CONNECTORS=3
